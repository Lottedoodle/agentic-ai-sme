# AWS Bedrock Knowledge Base + LLM
AWS_KNOWLEDGE_BASE_ID=your-kb-id
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KB_NUMBER_OF_RESULTS=5
AWS_BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional KB retrieval tuning
# AWS_KB_QUERY_REWRITE=true
# AWS_KB_QUERY_VARIANTS=3

# Supabase (frontend auth + optional REST fallback)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Backend API URL for Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Product catalog (Postgres)
DATABASE_URL=postgresql://user:password@host:6543/postgres
# SUPABASE_PRODUCTS_TABLE=products

# Or discrete PG_* vars instead of DATABASE_URL
# PG_HOST=
# PG_PORT=6543
# PG_USER=
# PG_PASSWORD=
# PG_DATABASE=postgres

# Pricing quote backend: local (default) or api (same JSON contract)
# PRICING_QUOTE_BACKEND=local
# PRICING_QUOTE_API_URL=https://example.com/api/quote

# CORS (optional)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
